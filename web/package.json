    "test": "npm run gen:routes && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:routes": "node scripts/gen-routes.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "5.3.0",
