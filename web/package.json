{
  "name": "zafirogo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:routes && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
