# Скопируйте в .env (cp .env.example .env). .env в git не попадает.
# Только dev-значения для docker-compose.dev.yml и локального запуска сервера.

# --- docker-compose.dev.yml ---
# POSTGRES_USER — владелец схемы: под ним работает только goose (task db:migrate), не сервер.
POSTGRES_DB=zafiro
POSTGRES_USER=zafiro
POSTGRES_PASSWORD=zafiro_dev_password
POSTGRES_PORT=5432
# Логины сервера (создаёт db/init/10-zafiro-logins.sh; на существующем томе — task db:logins).
ZAFIRO_DB_APP_USER=zafiro_app_login
ZAFIRO_DB_APP_PASSWORD=zafiro_app_dev_password
ZAFIRO_DB_PLATFORM_USER=zafiro_platform_login
ZAFIRO_DB_PLATFORM_PASSWORD=zafiro_platform_dev_password
VALKEY_PASSWORD=valkey_dev_password
VALKEY_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# --- сервер zafiro (префикс ZAFIRO_, см. server/internal/config и docs/dev-setup.md) ---
ZAFIRO_ENV=dev
ZAFIRO_HTTP_ADDR=:8080
# Логин роли zafiro_app (RLS по клубу) и логин роли zafiro_platform (фоновые задачи по всем клубам).
ZAFIRO_DATABASE_URL=postgres://zafiro_app_login:zafiro_app_dev_password@localhost:5432/zafiro?sslmode=disable
ZAFIRO_DATABASE_PLATFORM_URL=postgres://zafiro_platform_login:zafiro_platform_dev_password@localhost:5432/zafiro?sslmode=disable
ZAFIRO_VALKEY_ADDR=localhost:6379
ZAFIRO_VALKEY_PASSWORD=valkey_dev_password
ZAFIRO_NATS_URL=nats://localhost:4222
ZAFIRO_LOG_LEVEL=debug
ZAFIRO_LOG_FORMAT=text
ZAFIRO_SHUTDOWN_TIMEOUT=30s
# Через запятую, IP или CIDR обратных прокси; пусто — X-Forwarded-For игнорируется.
ZAFIRO_HTTP_TRUSTED_PROXIES=
# Хост wiki (WIKI_DOMAIN старого, Q-069), например wiki.zafiro.kz; пусто — wiki на /wiki.
ZAFIRO_HTTP_WIKI_HOST=
# gRPC агентов (mTLS). В dev CA и серверный сертификат генерируются в ZAFIRO_AGENT_PKI_DEV_DIR
# (по умолчанию .dev/pki относительно рабочего каталога; task dev:server задаёт <корень>/.dev/pki).
ZAFIRO_AGENT_GRPC_LISTEN=:8443
ZAFIRO_AGENT_GRPC_ENDPOINT=localhost:8443
# Секреты: пусто в dev — случайные до перезапуска (сессии и коды регистрации сбрасываются).
# Ключ подписи access-токенов: kid:секрет (≥ 32 байт), несколько — через запятую (первый подписывает).
ZAFIRO_AUTH_SIGNING_KEYS=
# Перец HMAC кодов регистрации ПК (≥ 32 байт).
ZAFIRO_AGENT_ENROLL_CODE_PEPPER=

# --- goose (task db:migrate; GOOSE_DRIVER=postgres задаёт Taskfile) — владелец схемы ---
GOOSE_DBSTRING=postgres://zafiro:zafiro_dev_password@localhost:5432/zafiro?sslmode=disable

# Кабинет суперадмина (Этап 3, G6): отдельный хост (Q-069; пусто — /superadmin), ключ шифрования токенов Telegram
# (≥ 32 байт, секрет), каталог бэкапов и домены SSL для экрана «Сервер».
ZAFIRO_SUPERADMIN_DOMAIN=
ZAFIRO_SUPERADMIN_SECRET_KEY=
ZAFIRO_SUPERADMIN_BACKUP_PATH=
ZAFIRO_SUPERADMIN_SSL_HOSTS=
