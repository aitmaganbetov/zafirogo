# Скопируйте в .env (cp .env.example .env). .env в git не попадает.
# Только dev-значения для docker-compose.dev.yml и локального запуска сервера.

# --- docker-compose.dev.yml ---
POSTGRES_DB=zafiro
POSTGRES_USER=zafiro
POSTGRES_PASSWORD=zafiro_dev_password
POSTGRES_PORT=5432
VALKEY_PASSWORD=valkey_dev_password
VALKEY_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# --- сервер zafiro (префикс ZAFIRO_, см. server/internal/config) ---
ZAFIRO_ENV=dev
ZAFIRO_HTTP_ADDR=:8080
ZAFIRO_DATABASE_URL=postgres://zafiro:zafiro_dev_password@localhost:5432/zafiro?sslmode=disable
ZAFIRO_VALKEY_ADDR=localhost:6379
ZAFIRO_VALKEY_PASSWORD=valkey_dev_password
ZAFIRO_NATS_URL=nats://localhost:4222
ZAFIRO_LOG_LEVEL=debug
ZAFIRO_LOG_FORMAT=text
ZAFIRO_SHUTDOWN_TIMEOUT=15s
# Через запятую, IP или CIDR обратных прокси; пусто — X-Forwarded-For игнорируется.
ZAFIRO_HTTP_TRUSTED_PROXIES=

# --- goose (task db:migrate; GOOSE_DRIVER=postgres задаёт Taskfile) ---
GOOSE_DBSTRING=postgres://zafiro:zafiro_dev_password@localhost:5432/zafiro?sslmode=disable
