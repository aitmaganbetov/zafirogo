<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Служба агента (решение 5 в CLAUDE.md): держит связь с сервером, выполняет команды, хранит ключ ПК и токен гостя,
    обслуживает локальный IPC для UI и запускает UI только когда нужен экран. Windows — служба Windows (SYSTEM),
    Linux — консольный хост для тестов. Native AOT: dotnet publish -r win-x64 -p:PublishAot=true.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Zafiro.Agent.Service</RootNamespace>
    <AssemblyName>Zafiro.Agent.Service</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zafiro.Agent.Core\Zafiro.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zafiro.Agent.Tests" />
  </ItemGroup>
</Project>
