<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Процесс UI агента (решение 5 в CLAUDE.md): WPF + WebView2, запускается службой в сеансе пользователя, только когда
    нужен экран (вход, блокировка, регистрация ПК, сообщение сотрудника) или гость открыл лаунчер. Сети и ключей у UI
    нет: всё — через IPC службы (ipc.proto). WebView2 создаётся при показе окна и освобождается при скрытии.
    Страница — Frontend/ (перенос WindowsAgent/Frontend старого агента), только с виртуального хоста, CSP.
    Сборка на Linux: EnableWindowsTargeting (CI собирает и на ubuntu); исполнение — только Windows 10/11.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RootNamespace>Zafiro.Agent.UI</RootNamespace>
    <AssemblyName>Zafiro.Agent.UI</AssemblyName>
    <ApplicationIcon>Assets\zafiro.ico</ApplicationIcon>
    <!-- Языки ввода Windows (РУС/ҚАЗ/ENG у поля пароля) — культуры ОС, не инвариантная. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zafiro.Agent.UI.Core\Zafiro.Agent.UI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\zafiro.ico" />
    <!-- Страница UI: копируется в <выход>\Frontend (виртуальный хост WebView2). Тесты JS — agent/tests/frontend. -->
    <Content Include="Frontend\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
