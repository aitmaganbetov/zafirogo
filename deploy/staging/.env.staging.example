# Переменные staging (docker compose --env-file deploy/staging/.env.staging; префикс STG_ — чтобы не смешаться с .env разработки, который Taskfile подгружает в окружение). Шаблон; рабочий файл .env.staging
# создаёт deploy/staging/init.sh (task staging:init) со случайными паролями. .env.staging в git не попадает.

# Образ сервера (task staging:image собирает zafiro:staging; из CI — ghcr.io/aitmaganbetov/zafirogo:<тег>@sha256:…).
STG_IMAGE=zafiro:staging

# Адрес, на котором nginx публикует 80/443/8443 (0.0.0.0 — на реальном staging-сервере).
STG_BIND=127.0.0.1
STG_HTTP_PORT=80
STG_HTTPS_PORT=443
STG_AGENT_PORT=8443

# Лимит дескрипторов nginx (≥ 2 × соединений агентов; не выше жёсткого лимита демона Docker; прод — ≥ 131072).
STG_LB_NOFILE=20000

# Postgres: суперпользователь контейнера (только инициализация тома), владелец схемы (миграции, PD-9) и логины сервера.
STG_POSTGRES_DB=zafiro
STG_POSTGRES_USER=postgres
STG_POSTGRES_PASSWORD=
STG_DB_OWNER_USER=zafiro_owner
STG_DB_OWNER_PASSWORD=
STG_DB_APP_USER=zafiro_app_login
STG_DB_APP_PASSWORD=
STG_DB_PLATFORM_USER=zafiro_platform_login
STG_DB_PLATFORM_PASSWORD=

STG_VALKEY_PASSWORD=
STG_NATS_PASSWORD=

# Образы зависимостей (тег + digest). При 429 Docker Hub — зеркало, тот же digest:
#   STG_POSTGRES_IMAGE=mirror.gcr.io/library/postgres:18.6@sha256:979bccfde35445db618c65107d27d08c6c21339d8dc3ad4c830c6633947be0e4
STG_POSTGRES_IMAGE=postgres:18.6@sha256:979bccfde35445db618c65107d27d08c6c21339d8dc3ad4c830c6633947be0e4
STG_VALKEY_IMAGE=valkey/valkey:9.1.3-alpine@sha256:bf09d58e96d6b4524a15396b65b242bbe18beebbcc15a04d8ee75ddac62fae0b
STG_NATS_IMAGE=nats:2.15.2-alpine@sha256:823e7f1d6d8ffe3b30dbd73d4a06bbb939acf94929f7fdf224404da7a05bafb5
STG_NGINX_IMAGE=nginx:1.30.5-alpine3.24@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
