# Закреплённые версии инструментов — ЕДИНСТВЕННОЕ место (аудит BC-09). Читают:
#   Taskfile.yml           — dotenv (task tools, task gen …);
#   .github/workflows/*    — шаг «versions»: строки KEY=value → $GITHUB_ENV;
#   Dockerfile             — стадия go: `. /tmp/versions.env` (GOOSE_VERSION);
#   tools/check-versions.sh — сверяет то, что файл прочитать не может (образ node в Dockerfile, комментарии buf).
# Формат: только KEY=value без кавычек и пробелов (его читают sh, Task и GitHub Actions).
# Обновлять осознанно: версия не моложе 14 дней (PD-4, docs/DECISIONS.md). Dependabot этот файл не видит.

# Go: версия тулчейна — источник server/go.mod (её читает actions/setup-go). Здесь — для скриптов и проверки
# «одна версия Go везде» (go.yml: go.mod = GO_VERSION = образы golang в Dockerfile и deploy/backup/Dockerfile;
# аудит SEC-3/SEC-4). Исправления уязвимостей — без 14-дневного ожидания (PD-4).
GO_VERSION=1.27.4

# Go-инструменты (go install …@версия)
TASK_VERSION=v3.54.0
SQLC_VERSION=v1.31.1
GOOSE_VERSION=v3.29.0
OAPI_CODEGEN_VERSION=v2.8.1
BUF_VERSION=v1.75.0
PROTOC_GEN_GO_VERSION=v1.36.12
PROTOC_GEN_GO_GRPC_VERSION=v1.6.2
GOLANGCI_LINT_VERSION=v2.15.0
GOVULNCHECK_VERSION=v1.9.0
GOSEC_VERSION=v2.30.0
# Линтер workflow GitHub Actions (deploy.yml, job actionlint; аудит OPS-10).
ACTIONLINT_VERSION=v1.7.7

# Node.js в CI (actions/setup-node) — та же версия, что образ NODE_IMAGE в Dockerfile (его обновляет Dependabot;
# расхождение ловит tools/check-versions.sh).
NODE_VERSION=22.23.3
